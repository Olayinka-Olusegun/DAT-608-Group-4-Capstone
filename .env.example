# Copy to .env and fill in. The file .env is git-ignored and is never read into logs.

# --- Storage -------------------------------------------------------------
# Leave DATABASE_URL unset to use the embedded SQLite warehouse.
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pau_risk

# --- Structured incident feeds ------------------------------------------
# ACLED issues keys at https://developer.acleddata.com
ACLED_API_KEY=
ACLED_EMAIL=
# UCDP issues API tokens on written request; the public GED CSV needs no token.
UCDP_API_TOKEN=

# --- Narrative generation -----------------------------------------------
ANTHROPIC_API_KEY=

# --- Social listening ----------------------------------------------------
X_BEARER_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- Alerting ------------------------------------------------------------
ALERT_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Streaming -----------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Experiment tracking -------------------------------------------------
MLFLOW_TRACKING_URI=sqlite:///./data/artifacts/mlflow.db
